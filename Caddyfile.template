{$SODAM_DOMAIN:2.sodam.store} {
	log {
		output stdout
		format json
	}
	handle /webhook/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /v1/events/* {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
			transport http {
				response_header_timeout 0
			}
		}
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /admin/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
